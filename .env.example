# Скопируйте файл в .env и заполните локально. .env не коммитируется.
# Node.js 24 LTS

BOT_TOKEN=
OWNER_CHAT_ID=
APP_URL=http://localhost:3000
PORT=3000

# Сгенерируйте независимую случайную строку 32–48 символов.
# Пример генерации: openssl rand -hex 24
WEBHOOK_SECRET=

# Только серверная конфигурация. Не вставляйте реальные реквизиты в Git/frontend.
# Для переноса строки используйте литеральные символы \n.
PAY_DETAILS=

# Доверять X-Forwarded-For только за управляемым reverse proxy.
TRUST_PROXY=false
ALLOW_BROWSER_ORDERS=false
ENABLE_BOT=true
ALLOWED_ORIGIN=
INITDATA_MAX_AGE=86400
MAX_RECEIPT_BYTES=10485760
TELEGRAM_API_BASE=https://api.telegram.org

# По умолчанию: data/runtime/orders.json. В тестах всегда уникальный временный путь.
# ORDERS_FILE=/absolute/private/path/orders.json
